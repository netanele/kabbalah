 "count": 27,
 "lines": [
  {
   "t": 0,
   "ts": "00:00:00",
   "text": "וזה טעם היות החסידים ובני הנביאים יושבים בגינות על אברי נהרים ומאזינים למיני כלי זמר ורננת ציפורים,"
  },
  {
   "t": 15,
   "ts": "00:00:15",
   "text": "משום שיש לכל הדברים הללו סוד בתורת ההתקשרות."
  },
  {
   "t": 22,
   "ts": "00:00:22",
   "text": "תורת ההתקשרות היא תורה עמוקה"
  },
  {
   "t": 24,
   "ts": "00:00:24",
   "text": "שגילה אותה רבי דוד מימוני"
  },
  {
   "t": 27,
   "ts": "00:00:27",
   "text": "בספרו מורה הפרישות"
  },
  {
   "t": 29,
   "ts": "00:00:29",
   "text": "שהוא היה דור שביעי לרמב״ם."
  },
  {
   "t": 32,
   "ts": "00:00:32",
   "text": "תורת ההתקשרות,"
  },
  {
   "t": 33,
   "ts": "00:00:33",
   "text": "התקשרות מלשון נחשב,"
  },
  {
   "t": 35,
   "ts": "00:00:35",
   "text": "שאדם הוא כלי כדי לקבל את האור הזך,"
  },
  {
   "t": 39,
   "ts": "00:00:39",
   "text": "הוא כלי כדי לקבל את השפע של הרגיעה, של השלווה,"
  },
  {
   "t": 43,
   "ts": "00:00:43",
   "text": "של ההעמקה הפנימית,"
  },
  {
   "t": 46,
   "ts": "00:00:46",
   "text": "של הביטחון הנפשי הפנימי, של העוצמה."
  },
  {
   "t": 51,
   "ts": "00:00:51",
   "text": "וכך כותב רבי דוד מהמוני בספרו מורה הפרישות,"
  },
  {
   "t": 56,
   "ts": "00:00:56",
   "text": "שבני הנביאים"
  },
  {
   "t": 58,
   "ts": "00:00:58",
   "text": "היו יושבים"
  },
  {
   "t": 59,
   "ts": "00:00:59",
   "text": "עלי נהר,"
  },
  {
   "t": 61,
   "ts": "00:01:01",
   "text": "עלי נהרות,"
  },
  {
   "t": 63,
   "ts": "00:01:03",
   "text": "על בארות המים,"
  },
  {
   "t": 65,
   "ts": "00:01:05",
   "text": "מקשיבים לרחש הציפורים,"
  },
  {
   "t": 69,
   "ts": "00:01:09",
   "text": "מסתכלים על השקיעות והזריחות,"
  },
  {
   "t": 72,
   "ts": "00:01:12",
   "text": "כי בהם,"
  },
  {
   "t": 73,
   "ts": "00:01:13",
   "text": "כמו שהרב כותב,"
  },
  {
   "t": 75,
   "ts": "00:01:15",
   "text": "משום שיש לכל הדברים הללו"
  },
  {
   "t": 78,
   "ts": "00:01:18",
   "text": "סוד בתורת ההתקשרות."
  },
  {
   "t": 81,
   "ts": "00:01:21",
   "text": "אז יהי רצון שנהיה"
  },
  {
   "t": 82,
   "ts": "00:01:22",
   "text": "כלי מוכשר"
  },
  {
   "t": 84,
   "ts": "00:01:24",
   "text": "לקבר את הרוגע ואת הורשי."
  }
 ]
}
